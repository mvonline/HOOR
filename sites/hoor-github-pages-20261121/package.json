{
  "name": "hoor-design-portal-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-map.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "snapshot": "python3 ../../tools/build_snapshot.py",
    "encrypt": "node scripts/encrypt-content.mjs",
    "dialogues": "python3 -I ../../tools/sync_dialogues.py",
    "verify": "python3 -I ../../tools/check_continuity.py"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "marked": "18.2.1",
    "d3-geo": "3.1.1"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "esbuild": "0.28.0"
  }
}
